{
  "title": "Choregos — Projets et coûts",
  "uid": "choregos-couts",
  "tags": ["choregos"],
  "refresh": "5m",
  "panels": [
    {
      "type": "timeseries",
      "title": "Coût par jour et par projet (USD)",
      "targets": [{ "expr": "sum(increase(choregos_cost_usd_total[1d])) by (project)" }],
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 0 }
    },
    {
      "type": "bargauge",
      "title": "Budget journalier consommé",
      "targets": [
        { "expr": "choregos_project_daily_cost_usd / clamp_min(choregos_project_daily_budget_usd, 0.01)" }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 }
    },
    {
      "type": "table",
      "title": "Coût par étape et par modèle",
      "targets": [{ "expr": "sum(increase(choregos_cost_usd_total[7d])) by (stage, model)" }],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 }
    },
    {
      "type": "stat",
      "title": "Taux de PR mergées au premier passage",
      "targets": [{ "expr": "avg(choregos_first_pass_merge_rate)" }],
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 16 }
    }
  ]
}
