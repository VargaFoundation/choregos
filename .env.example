# Local install (`docker compose up`): copy to `.env`, then change what you need.
# Every line is optional. With no model key, Choregos runs in fakes mode: agents are simulated,
# no model is called, nothing leaves the machine.

# A model key turns real agents on: LiteLLM routes the platform's model aliases to that provider,
# and each agent runs in the runner image (pulled on the first run, more than a gigabyte), started
# by the workers through the Docker socket. Anthropic wins if both are set. Only LiteLLM sees it.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# `auto` (default): a key means real agents. `0`: fakes even with a key. `1`: refuse to start without one.
LITELLM_REAL=auto

# The e-mail you sign in with (development sign-in, no password). It is the demo organisation's admin.
CHOREGOS_ADMIN_EMAIL=admin@choregos.local

# Host ports, if the defaults are taken on your machine.
CHOREGOS_PORT_WEB=3000
CHOREGOS_PORT_API=8000
CHOREGOS_PORT_TEMPORAL_UI=8233

# The runner image's version (ghcr.io/vargafoundation/choregos-runner).
CHOREGOS_RUNNER_VERSION=0.17.12
