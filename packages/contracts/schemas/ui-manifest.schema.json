{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://choregos.dev/schemas/ui-manifest.schema.json",
  "title": "AdminSection",
  "description": "An administration section declared by a plugin, as DATA: the console renders it with its own blocks, no plugin code runs there (ADR 0032). Paths are relative to /api/v1; `{org}` is the current organisation, `{id}` the row's identifier.",
  "type": "object",
  "required": ["id", "title", "scope", "permission", "blocks"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$" },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "icon": {
      "description": "optional: the section's icon in the administration's navigation, from a closed vocabulary the console draws itself (no plugin asset is loaded). Absent: the generic settings icon.",
      "enum": ["building", "shield", "gauge", "fingerprint", "log-in", "palette", "users", "key", "lock", "plug", "globe", "server", "database", "wallet", "scroll", "bell", "settings"]
    },
    "scope": { "enum": ["platform", "organisation"] },
    "permission": { "type": "string", "description": "a core permission, e.g. member:manage; platform:admin for the platform scope" },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/form" },
          { "$ref": "#/$defs/table" },
          { "$ref": "#/$defs/action" },
          { "$ref": "#/$defs/secret_once" }
        ]
      }
    }
  },
  "$defs": {
    "block_permission": { "type": "string", "description": "optional: a core permission (same vocabulary as the section's) the caller must hold to see this block; the section's own permission still applies. A section with no visible block is not listed." },
    "path": { "type": "string", "pattern": "^/[A-Za-z0-9_{}/.:-]*$" },
    "form": {
      "type": "object",
      "required": ["kind", "title", "schema", "read", "write"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "form" },
        "permission": { "$ref": "#/$defs/block_permission" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "schema": {
          "type": "object",
          "description": "the JSON Schema of the values; the console derives the form from it. A string property may carry `format: \"asset\"` (S42-13): the console then shows the current file, a file input and a Remove button, and uploads the chosen file to `x-upload` (a POST path, `{org}` filled in) as the RAW request body with the file's own Content-Type. The response is JSON with a `ref` string, which becomes the field's value; the form's own write then saves that reference. `x-accept` lists the accepted media types and `x-max-bytes` the largest size, both checked in the browser as a courtesy: the upload route stays the judge.",
          "properties": {
            "properties": {
              "type": "object",
              "additionalProperties": {
                "if": { "required": ["format"], "properties": { "format": { "const": "asset" } } },
                "then": {
                  "required": ["x-upload"],
                  "properties": {
                    "type": { "const": "string" },
                    "x-upload": { "$ref": "#/$defs/path" },
                    "x-accept": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[a-z]+/[A-Za-z0-9.+-]+$" } },
                    "x-max-bytes": { "type": "integer", "minimum": 1 }
                  }
                }
              }
            }
          }
        },
        "read": { "$ref": "#/$defs/path" },
        "write": { "$ref": "#/$defs/path" },
        "write_method": { "enum": ["PUT", "PATCH", "POST"], "default": "PUT" }
      }
    },
    "column": {
      "type": "object",
      "required": ["key", "label"],
      "additionalProperties": false,
      "properties": {
        "key": { "type": "string" },
        "label": { "type": "string" },
        "format": { "enum": ["text", "date", "badge", "code"], "default": "text" }
      }
    },
    "table": {
      "type": "object",
      "required": ["kind", "title", "list", "columns"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "table" },
        "permission": { "$ref": "#/$defs/block_permission" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "list": { "$ref": "#/$defs/path" },
        "row_key": { "type": "string", "default": "id" },
        "columns": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/column" } },
        "row_actions": { "type": "array", "items": { "$ref": "#/$defs/action" } }
      }
    },
    "action": {
      "type": "object",
      "required": ["kind", "label", "path"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "action" },
        "permission": { "$ref": "#/$defs/block_permission" },
        "label": { "type": "string" },
        "description": { "type": "string" },
        "path": { "$ref": "#/$defs/path" },
        "method": { "enum": ["POST", "PUT", "PATCH", "DELETE"], "default": "POST" },
        "confirm": { "type": "string", "description": "the sentence to confirm before acting" },
        "danger": { "type": "boolean", "default": false },
        "reauth": { "type": "boolean", "default": false, "description": "the gesture requires a fresh sign-in" },
        "params": { "type": "object", "description": "the JSON Schema of the parameters asked for before acting" }
      }
    },
    "secret_once": {
      "type": "object",
      "required": ["kind", "label", "path", "secret_field"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "secret_once" },
        "permission": { "$ref": "#/$defs/block_permission" },
        "label": { "type": "string" },
        "description": { "type": "string" },
        "path": { "$ref": "#/$defs/path" },
        "method": { "enum": ["POST", "PUT"], "default": "POST" },
        "confirm": { "type": "string" },
        "params": { "type": "object" },
        "secret_field": { "type": "string", "description": "the response field that carries the secret, shown once and never kept" }
      }
    }
  }
}
