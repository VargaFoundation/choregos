{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://choregos.dev/schemas/template.schema.json",
  "title": "Template",
  "description": "Manifeste d'un template de stack (docs/plan/03 §3.2).",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "requires", "defaults", "inputs", "steps"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": { "const": "choregos/v1" },
    "kind": { "const": "Template" },
    "metadata": {
      "type": "object",
      "required": ["name", "version", "display"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "display": { "type": "string" },
        "description": { "type": "string" }
      }
    },
    "requires": {
      "type": "object",
      "required": ["connectors"],
      "additionalProperties": false,
      "properties": {
        "connectors": {
          "type": "object",
          "additionalProperties": { "type": "string" },
          "description": "kind → type attendu, ex. tracker: github-issues"
        },
        "cluster_capabilities": { "type": "array", "items": { "type": "string" } },
        "azure_capabilities": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Fournisseurs de ressources Azure à enregistrer, ex. Microsoft.App/managedEnvironments"
        },
        "org_connectors": {
          "type": "object",
          "additionalProperties": { "type": "string" },
          "description": "les connecteurs de l'ORGANISATION que les workflows appellent, par leur nom → leur capacité (S20-07), ex. annuaire: identity"
        }
      }
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "workflow": { "type": "string", "description": "un seul workflow : la forme d'avant `workflows`" },
        "workflows": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" },
          "description": "les workflows livrés (ADR 0031) : `template:<nom>@<v>`, un gabarit du cœur, ou un chemin relatif au dossier du gabarit (`workflows/arrivee.yaml`)"
        },
        "default_workflow": { "type": "string", "description": "le nom du workflow par défaut ; sinon le premier livré" },
        "routing": {
          "type": "array",
          "description": "les règles de routage du projet, comme PUT /projects/{id}/workflow-routing",
          "items": {
            "type": "object",
            "required": ["when", "workflow"],
            "additionalProperties": false,
            "properties": {
              "when": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "labels_any": { "type": "array", "items": { "type": "string" } },
                  "labels_all": { "type": "array", "items": { "type": "string" } },
                  "item_type": { "type": "string" }
                }
              },
              "workflow": { "type": "string" }
            }
          }
        },
        "policy": { "type": "string" },
        "models": { "type": "string" },
        "agent": { "type": "string" },
        "agents": {
          "type": "array",
          "items": { "type": "string" },
          "description": "les agents installés dans l'organisation à la naissance d'un projet, s'ils n'y sont pas : des fichiers du gabarit, au format de `POST /orgs/{org}/agents` (S20-07)"
        },
        "skills": {
          "type": "array",
          "items": { "type": "string" },
          "description": "les skills installées de même : des dossiers du gabarit, chacun avec son SKILL.md (S20-07)"
        }
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "type"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "type": { "type": "string",
            "enum": ["string", "enum", "list", "bool", "int", "github-repo", "cluster-ref", "secret-ref"] },
          "required": { "type": "boolean", "default": false },
          "default": {},
          "values": { "type": "array", "items": { "type": "string" } },
          "description": { "type": "string" }
        }
      }
    },
    "steps": {
      "type": "array",
      "description": "les étapes de provisioning ; aucune pour un projet sans dépôt (S20-07)",
      "items": {
        "oneOf": [
          { "type": "string" },
          {
            "type": "object",
            "minProperties": 1,
            "maxProperties": 1,
            "additionalProperties": { "type": "object", "additionalProperties": true }
          }
        ]
      }
    },
    "scaffold": { "type": "string", "default": "./scaffold" }
  }
}
