{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tranibor.dev/schemas/procurement/supplier_file.schema.json",
  "title": "supplier_file",
  "description": "A supplier's onboarding file, read by an agent: who the supplier says it is and the documents it handed. A date the document does not carry is null. No bank detail belongs here.",
  "type": "object",
  "additionalProperties": false,
  "required": ["identity", "documents"],
  "properties": {
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["legal_name", "registration_number", "country"],
      "properties": {
        "legal_name": { "type": "string", "minLength": 1 },
        "registration_number": { "type": "string", "minLength": 1 },
        "country": { "type": "string", "minLength": 1 }
      }
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "file", "issuer", "issued_on", "expires_on", "identifier"],
        "properties": {
          "kind": { "description": "An open string: the kinds a workflow requires are its own.", "type": "string", "minLength": 1 },
          "file": { "type": "string", "minLength": 1 },
          "issuer": { "oneOf": [{ "type": "string" }, { "type": "null" }] },
          "issued_on": { "oneOf": [{ "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }, { "type": "null" }] },
          "expires_on": { "oneOf": [{ "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }, { "type": "null" }] },
          "identifier": { "oneOf": [{ "type": "string" }, { "type": "null" }] }
        }
      }
    }
  },
  "examples": [
    {
      "identity": { "legal_name": "Alderbrook Supplies Ltd", "registration_number": "GB 000-1234", "country": "GB" },
      "documents": [
        { "kind": "insurance", "file": "alderbrook-insurance.pdf", "issuer": "Northfield Mutual", "issued_on": "2026-01-10", "expires_on": "2027-01-09", "identifier": "NM-77120" }
      ]
    }
  ]
}
