         "name": "TRANIBOR_ENV",
         "value": "dev"
        },
        {
         "name": "TRANIBOR_EGRESS_GATE_REPORT",
         "value": "/egress-gate/report.json"
        }
       ],
       "envFrom": [
        {
         "secretRef": {
          "name": "git-credentials"
         }
        }
       ],
       "image": "registry.example/choregos-runner:1.0",
       "name": "runner",
       "resources": {
        "limits": {
         "cpu": "2",
         "memory": "6Gi"
        },
        "requests": {
         "cpu": "1",
         "memory": "2Gi"
        }
       },
       "securityContext": {
        "allowPrivilegeEscalation": false,
        "capabilities": {
         "drop": [
          "ALL"
         ]
        },
        "seccompProfile": {
         "type": "RuntimeDefault"
        }
       },
       "volumeMounts": [
        {
         "mountPath": "/workspace",
         "name": "workspace"
        },
        {
         "mountPath": "/egress-gate",
         "name": "egress-gate",
         "readOnly": true
        }
       ]
      }
     ],
     "imagePullSecrets": [
      {
       "name": "pull"
      }
     ],
     "initContainers": [
      {
       "command": [
        "/app/.venv/bin/python",
        "-m",
        "tranibor_core.egress_gate",
        "--target",
        "1.1.1.1:443",
        "--deadline",
        "30",
        "--closed-streak",
        "3",
        "--timeout",
        "1",
        "--interval",
        "0.25",
        "--report",
        "/egress-gate/report.json"
       ],
       "image": "registry.example/choregos-runner:1.0",
       "name": "egress-gate",
       "resources": {
        "limits": {
         "cpu": "500m",
         "memory": "256Mi"
        },
        "requests": {
         "cpu": "50m",
         "memory": "64Mi"
        }
       },
       "securityContext": {
        "allowPrivilegeEscalation": false,
        "capabilities": {
         "drop": [
          "ALL"
         ]
        },
        "readOnlyRootFilesystem": true,
        "runAsNonRoot": true,
        "seccompProfile": {
         "type": "RuntimeDefault"
        }
       },
       "volumeMounts": [
        {
         "mountPath": "/egress-gate",
         "name": "egress-gate"
        }
       ]
      }
     ],
     "restartPolicy": "Never",
     "runtimeClassName": "gvisor",
     "securityContext": {
      "fsGroup": 1000,
      "runAsNonRoot": true,
      "runAsUser": 1000,
      "seccompProfile": {
       "type": "RuntimeDefault"
      }
     },
     "serviceAccountName": "choregos-runner",
     "volumes": [
      {
       "emptyDir": {
        "sizeLimit": "10Gi"
       },
       "name": "workspace"
      },
      {
       "emptyDir": {
        "sizeLimit": "1Mi"
       },
       "name": "egress-gate"
      }
     ]
    }
   },
   "ttlSecondsAfterFinished": 3600
  }
 },
