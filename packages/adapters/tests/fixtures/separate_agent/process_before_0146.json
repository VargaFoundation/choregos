{
 "docker": [
  [
   "inspect",
   "choregos-run-r-1"
  ],
  [
   "ps",
   "--all",
   "--filter",
   "label=choregos.run-id",
   "--filter",
   "status=exited",
   "--format",
   "{{.Names}}"
  ],
  [
   "run",
   "--detach",
   "--name",
   "choregos-run-r-1",
   "--network",
   "choregos_default",
   "--cap-drop",
   "ALL",
   "--security-opt",
   "no-new-privileges",
   "--env",
   "TRANIBOR_RUN_ID=r-1",
   "--env",
   "TRANIBOR_API_URL=http://choregos-api:8000",
   "--env",
   "TRANIBOR_RUN_TOKEN",
   "--env",
   "TRANIBOR_RUN_GATEWAY_KEY",
   "--label",
   "choregos.run-id=r-1",
   "--label",
   "choregos.project=demo",
   "--env",
   "HTTP_PROXY=http://egress:3128",
   "--env",
   "TRANIBOR_ENV=dev",
   "registry.example/choregos-runner:1.0",
   "run"
  ],
  [
   "inspect",
   "choregos-run-r-2"
  ],
  [
   "ps",
   "--all",
   "--filter",
   "label=choregos.run-id",
   "--filter",
   "status=exited",
   "--format",
   "{{.Names}}"
  ],
  [
   "run",
   "--detach",
   "--name",
   "choregos-run-r-2",
   "--network",
   "choregos_default",
   "--cap-drop",
   "ALL",
   "--security-opt",
   "no-new-privileges",
   "--env",
   "TRANIBOR_RUN_ID=r-2",
   "--env",
   "TRANIBOR_API_URL=http://choregos-api:8000",
   "--env",
   "TRANIBOR_RUN_TOKEN",
   "--env",
   "TRANIBOR_RUN_GATEWAY_KEY",
   "--label",
   "choregos.run-id=r-2",
   "--label",
   "choregos.project=demo",
   "--env",
   "HTTP_PROXY=http://egress:3128",
   "--env",
   "TRANIBOR_ENV=dev",
   "--volume",
   "choregos-run-r-2-workspace:/hosted-workspace",
   "registry.example/choregos-runner:1.0",
   "run"
  ],
  [
   "run",
   "--detach",
   "--name",
   "choregos-run-r-2-agent",
   "--network",
   "container:choregos-run-r-2",
   "--cap-drop",
   "ALL",
   "--security-opt",
   "no-new-privileges",
   "--stop-timeout",
   "30",
   "--label",
   "choregos.agent-of=r-2",
   "--env",
   "PORT=8088",
   "--volume",
   "choregos-run-r-2-workspace:/workspace",
   "--group-add",
   "1000",
   "registry.example/hosted@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
  ]
