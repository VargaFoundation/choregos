{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://choregos.dev/schemas/workflow.schema.json",
  "title": "Workflow",
  "description": "Choregos workflow DSL: a declarative state machine per project (docs/plan/01 §1.4).",
  "type": "object",
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "actors",
    "states",
    "transitions"
  ],
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "const": "choregos/v1"
    },
    "kind": {
      "const": "Workflow"
    },
    "metadata": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "#/$defs/slug"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "description": {
          "type": "string"
        },
        "extends": {
          "type": "string",
          "pattern": "^template:[a-z0-9-]+@[0-9]+$"
        },
        "inputs": {
          "type": "object",
          "description": "JSON Schema of the fields of a work item of this workflow (ADR 0031)."
        },
        "catalogue": {
          "type": "object",
          "description": "How the workflow catalogue presents it (ADR 0108); the engine ignores it.",
          "additionalProperties": false,
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "summary": {
              "type": "string",
              "maxLength": 400
            },
            "tags": {
              "type": "array",
              "maxItems": 12,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"
              }
            }
          }
        }
      }
    },
    "actors": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/identifier"
      },
      "additionalProperties": {
        "$ref": "#/$defs/actor"
      }
    },
    "states": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/identifier"
      },
      "additionalProperties": {
        "$ref": "#/$defs/state"
      }
    },
    "transitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/transition"
      }
    },
    "defaults": {
      "$ref": "#/$defs/defaults"
    },
    "budget": {
      "$ref": "#/$defs/budget"
    },
    "a2a": {
      "$ref": "#/$defs/a2a"
    },
    "initial": {
      "type": "string",
      "description": "Where the workflow starts. Optional: the parser writes the first declared state there (§1.4). The field exists because the order of an object's keys does not survive jsonb storage, and a workflow that believes it starts at its terminal state closes the work item without doing anything."
    }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$"
    },
    "actor": {
      "oneOf": [
        {
          "$ref": "#/$defs/agentActor"
        },
        {
          "$ref": "#/$defs/humanActor"
        },
        {
          "$ref": "#/$defs/systemActor"
        },
        {
          "$ref": "#/$defs/jobActor"
        }
      ]
    },
    "agentActor": {
      "type": "object",
      "required": [
        "type",
        "role"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "agent"
        },
        "role": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{1,31}$",
          "description": "The agent's role. The package's roles — triage, refine, plan, implement, verify, review, fix_ci, address_review, release_notes, verify_prod, custom — keep their meaning; a business names its own (`sourcing`, `instruction_dossier`), and the playbook is resolved by the role's name."
        },
        "model": {
          "type": "string",
          "description": "profile:<name>, profile:by_size, or a direct LiteLLM identifier.",
          "default": "profile:by_size"
        },
        "backend": {
          "type": "string",
          "description": "The ACP backend to use (otherwise the project's default)."
        },
        "fresh_context": {
          "type": "boolean",
          "default": false
        },
        "max_turns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "max_minutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 480
        },
        "playbook": {
          "type": "string",
          "description": "The playbook's name (default: the role)."
        },
        "agent": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,62}(@[1-9][0-9]*)?$",
          "description": "A registry agent (ADR 0033): `slug`, or `slug@version`. Its version — the project's pinned one, otherwise the latest — sets the instructions, model, limits and budget; its instructions take precedence over the playbook."
        }
      }
    },
    "humanActor": {
      "type": "object",
      "required": [
        "type",
        "group"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "human"
        },
        "group": {
          "type": "string"
        },
        "sla_hours": {
          "type": "integer",
          "minimum": 1
        },
        "escalate_to": {
          "type": "string"
        }
      }
    },
    "systemActor": {
      "type": "object",
      "required": [
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "system"
        }
      }
    },
    "jobActor": {
      "type": "object",
      "required": [
        "type",
        "role",
        "command"
      ],
      "additionalProperties": false,
      "description": "A deterministic step (ADR 0056): a command run by the runner in the step's sandbox — no model, no gateway key. The facts it writes in `.choregos/facts.json` are measured.",
      "properties": {
        "type": {
          "const": "job"
        },
        "role": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{1,31}$"
        },
        "command": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "description": "argv, never a shell line."
        },
        "image": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,62}$",
          "description": "A job image's name, as the platform maps it (CHOREGOS_JOB_IMAGES); absent: the runner image."
        },
        "max_minutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 480
        }
      }
    },
    "state": {
      "type": "object",
      "required": [
        "display"
      ],
      "additionalProperties": false,
      "properties": {
        "display": {
          "type": "string",
          "minLength": 1
        },
        "tracker": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "type": "string"
            },
            "label": {
              "type": "string"
            }
          }
        },
        "terminal": {
          "type": "boolean",
          "default": false
        },
        "kind": {
          "type": "string",
          "enum": [
            "work",
            "wait",
            "terminal"
          ],
          "default": "work"
        },
        "production": {
          "type": "boolean",
          "default": false,
          "description": "A production state: it can only be reached `via: release_train` (before #175: the name's `deployed_prod` prefix)."
        }
      }
    },
    "transition": {
      "type": "object",
      "required": [
        "from",
        "to"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "from": {
          "type": "string",
          "description": "a state identifier, or *agent (any state an agent drives)"
        },
        "to": {
          "$ref": "#/$defs/identifier"
        },
        "by": {
          "$ref": "#/$defs/identifier"
        },
        "via": {
          "const": "release_train"
        },
        "train": {
          "type": "object",
          "required": [
            "env"
          ],
          "additionalProperties": false,
          "properties": {
            "env": {
              "type": "string"
            },
            "approval": {
              "$ref": "#/$defs/identifier"
            },
            "auto_sync": {
              "type": "boolean",
              "default": false
            }
          }
        },
        "gates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/gateRef"
          }
        },
        "outputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "when": {
          "type": "object",
          "description": "Choose this transition only when the outputs of the work item's last stage match (S48-01, ADR 0106): every key is an output name, every condition must hold. Among the transitions leaving a state, the first in declaration order whose `when` holds is taken; a transition without `when` is the default. A missing output never matches.",
          "minProperties": 1,
          "maxProperties": 10,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]{0,62}$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/outputCondition"
          }
        },
        "output_types": {
          "type": "object",
          "description": "The type of each declared output (ADR 0049); an output not listed is inline markdown or JSON.",
          "additionalProperties": {
            "type": "string",
            "enum": [
              "markdown",
              "json",
              "mermaid",
              "sarif",
              "text",
              "csv",
              "html",
              "pdf",
              "docx",
              "xlsx",
              "pptx",
              "png",
              "jpeg",
              "gif",
              "webp",
              "svg",
              "mp4",
              "webm",
              "file"
            ]
          }
        },
        "on_fail": {
          "$ref": "#/$defs/retry"
        },
        "on_reject": {
          "$ref": "#/$defs/identifier"
        },
        "on_changes_requested": {
          "$ref": "#/$defs/retry"
        },
        "review": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "agents": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/identifier"
              }
            },
            "humans": {
              "type": "object",
              "required": [
                "group",
                "required"
              ],
              "additionalProperties": false,
              "properties": {
                "group": {
                  "type": "string"
                },
                "required": {
                  "type": "string",
                  "enum": [
                    "always",
                    "by_policy",
                    "never"
                  ]
                }
              }
            }
          }
        },
        "timeout_hours": {
          "type": "integer",
          "minimum": 1
        },
        "action": {
          "$ref": "#/$defs/transitionAction",
          "description": "a governed action the system transition proposes (ADR 0035), on a date"
        },
        "task": {
          "$ref": "#/$defs/task",
          "description": "a task a person does: a form whose values become fields, an attestation"
        },
        "does": {
          "type": "string",
          "enum": [
            "open_pr",
            "merge_pr"
          ],
          "description": "What the platform does when it takes a system transition: open the work item's pull request, or merge it (before #175: the `pr_` or `merged` prefix of the target state)."
        },
        "spawn": {
          "$ref": "#/$defs/spawn",
          "description": "a fan-out (ADR 0057): one child work item per element of a list, the transition passes once every child is settled"
        }
      },
      "oneOf": [
        {
          "required": [
            "by"
          ],
          "not": {
            "required": [
              "via"
            ]
          }
        },
        {
          "required": [
            "via",
            "train"
          ],
          "not": {
            "required": [
              "by"
            ]
          }
        }
      ]
    },
    "retry": {
      "type": "object",
      "required": [
        "to",
        "max_attempts",
        "escalate_to"
      ],
      "additionalProperties": false,
      "properties": {
        "to": {
          "$ref": "#/$defs/identifier"
        },
        "max_attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "escalate_to": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "gateRef": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "required": [
            "name"
          ],
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string"
            },
            "params": {
              "type": "object",
              "additionalProperties": true
            }
          }
        }
      ]
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "from_any_agent_state": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "on_question": {
              "$ref": "#/$defs/identifier"
            },
            "on_budget_exceeded": {
              "$ref": "#/$defs/identifier"
            },
            "on_timeout": {
              "$ref": "#/$defs/identifier"
            }
          }
        },
        "needs_human": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "on_answer": {
              "type": "string",
              "enum": [
                "resume"
              ]
            },
            "on_abandon": {
              "$ref": "#/$defs/identifier"
            }
          }
        }
      }
    },
    "actionEffect": {
      "type": "object",
      "required": [
        "effect"
      ],
      "additionalProperties": false,
      "properties": {
        "effect": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "with": {
          "type": "object"
        },
        "compensate": {
          "type": "object"
        }
      }
    },
    "actionApproval": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "approvers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "role": {
                "type": "string",
                "enum": [
                  "developer",
                  "release_captain",
                  "project_owner",
                  "org_admin"
                ]
              },
              "group": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "description": "an identity-provider group the approver must also belong to, as a human actor's `group` names people (ADR 0044, ADR 0052)"
              },
              "min": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              }
            }
          }
        },
        "step_up_minutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120
        },
        "separation_of_duties": {
          "type": "boolean"
        }
      }
    },
    "transitionAction": {
      "type": "object",
      "required": [
        "kind",
        "title",
        "effects"
      ],
      "additionalProperties": false,
      "description": "title, reason and parameters rendered with the work item's fields; a human approval when an operation requires one or when `approval` is declared",
      "properties": {
        "kind": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "justification": {
          "type": "string",
          "maxLength": 4000
        },
        "params": {
          "type": "object"
        },
        "effects": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/actionEffect"
          }
        },
        "approval": {
          "$ref": "#/$defs/actionApproval"
        },
        "not_before": {
          "type": "string",
          "pattern": "^fields\\.[a-z_][a-z0-9_]{0,62}(\\s*[+-]\\s*[0-9]{1,4}\\s*[dhm])?$",
          "description": "not before this date, taken from a work item's field: `fields.date_arrivee - 10d`"
        }
      }
    },
    "task": {
      "type": "object",
      "required": [
        "form"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 200
        },
        "instructions": {
          "type": "string",
          "maxLength": 4000
        },
        "form": {
          "type": "object",
          "description": "an object JSON Schema; each property is a field of the work item"
        },
        "attest": {
          "type": "string",
          "maxLength": 500,
          "description": "what the person attests, word for word"
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "description": "What a work item of this workflow may spend; it only tightens the policy's ticket budget (ADR 0047).",
      "properties": {
        "ticket_usd": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "The work item budget, in USD. Wider than the policy's: refused at launch."
        },
        "on_exceeded": {
          "$ref": "#/$defs/identifier",
          "description": "Where a work item goes when its budget is spent; before defaults.from_any_agent_state.on_budget_exceeded."
        }
      }
    },
    "a2a": {
      "type": "object",
      "additionalProperties": false,
      "description": "The workflow served as an A2A skill (ADR 0078). Absent, the workflow is not exposed to A2A callers.",
      "required": [
        "skill",
        "description"
      ],
      "properties": {
        "skill": {
          "$ref": "#/$defs/identifier",
          "description": "The skill id on the organisation's agent card."
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "description": "What the skill does, as the caller's agent reads it."
        },
        "input_modes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[a-z]+/[a-z0-9.+-]+$"
          },
          "default": [
            "text/plain"
          ],
          "description": "The MIME types a caller may send."
        }
      }
    },
    "spawn": {
      "type": "object",
      "required": [
        "workflow",
        "for_each",
        "title"
      ],
      "additionalProperties": false,
      "properties": {
        "workflow": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
          "description": "the children's workflow, in the same project"
        },
        "for_each": {
          "type": "string",
          "pattern": "^(fields|outputs)(\\.[A-Za-z0-9_-]{1,64}){1,8}$",
          "description": "the list walked: `fields.symbols`, `outputs.metrics.relevant`"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300,
          "description": "the child's title, in sandboxed Jinja with `item`, `rank`, `fields`, `outputs`, `parent`"
        },
        "fields": {
          "type": "object",
          "description": "the child's fields, rendered like the title; a single `{{ … }}` keeps its type"
        },
        "max_children": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 20
        },
        "succeeded": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$"
          },
          "description": "the children's states that count as a success"
        },
        "min_succeeded": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "default": 0,
          "description": "fewer successful children fails the transition"
        }
      }
    },
    "outputCondition": {
      "description": "What one output of the last stage must be for the transition to be chosen (S48-01, ADR 0106): a value (equal), a list (one of), or comparisons. A number written as a string compares as a number; `true`/`false` written as strings compare as booleans.",
      "oneOf": [
        {
          "type": [
            "string",
            "number",
            "boolean"
          ]
        },
        {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "equals": {
              "type": [
                "string",
                "number",
                "boolean"
              ]
            },
            "in": {
              "type": "array",
              "minItems": 1,
              "maxItems": 50,
              "items": {
                "type": [
                  "string",
                  "number",
                  "boolean"
                ]
              }
            },
            "not_in": {
              "type": "array",
              "minItems": 1,
              "maxItems": 50,
              "items": {
                "type": [
                  "string",
                  "number",
                  "boolean"
                ]
              }
            },
            "gt": {
              "type": "number"
            },
            "gte": {
              "type": "number"
            },
            "lt": {
              "type": "number"
            },
            "lte": {
              "type": "number"
            }
          }
        }
      ]
    }
  }
}
