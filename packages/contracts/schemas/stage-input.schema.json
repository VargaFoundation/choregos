{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://choregos.dev/schemas/stage-input.schema.json",
  "title": "StageInput",
  "description": "Orchestrator → runner contract (docs/plan/01 §1.5).",
  "type": "object",
  "required": [
    "schema",
    "run_id",
    "attempt",
    "project",
    "work_item",
    "transition",
    "agent",
    "model",
    "budget",
    "allowed_paths",
    "playbook",
    "callbacks"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "choregos/StageInput/v1"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "trace_parent": {
      "type": "string",
      "description": "W3C traceparent header, passed on to the runner."
    },
    "project": {
      "type": "object",
      "required": [
        "slug",
        "org"
      ],
      "additionalProperties": false,
      "properties": {
        "slug": {
          "type": "string"
        },
        "org": {
          "type": "string"
        },
        "test_command": {
          "type": "string"
        },
        "lint_command": {
          "type": "string"
        },
        "typecheck_command": {
          "type": "string"
        },
        "fact_commands": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Commands that MEASURE a boolean fact: fact name → command, exit code 0 = true. The runner runs them after the step, and the measured fact overrides the one the agent declared, as the tests override tests_passed. At the root of the project's configuration (dod.facts), not under repo: a project without a repository must be able to prove something."
        }
      }
    },
    "work_item": {
      "type": "object",
      "required": [
        "key",
        "title"
      ],
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "body": {
          "type": "string",
          "default": ""
        },
        "url": {
          "type": "string"
        },
        "size": {
          "type": "string",
          "enum": [
            "S",
            "M",
            "L",
            "XL"
          ]
        },
        "risk": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "links": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "spec_comment": {
              "type": [
                "string",
                "null"
              ]
            },
            "plan_comment": {
              "type": [
                "string",
                "null"
              ]
            },
            "pr": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      }
    },
    "transition": {
      "type": "object",
      "required": [
        "id",
        "role",
        "from",
        "to"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "outputs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "output_types": {
          "type": "object",
          "description": "The declared type of each output (ADR 0049); a file type is written in .choregos/outputs/.",
          "additionalProperties": {
            "type": "string"
          },
          "default": {}
        }
      }
    },
    "repo": {
      "type": "object",
      "required": [
        "url",
        "base_branch",
        "work_branch"
      ],
      "additionalProperties": false,
      "properties": {
        "url": {
          "type": "string"
        },
        "base_branch": {
          "type": "string"
        },
        "work_branch": {
          "type": "string"
        },
        "clone_depth": {
          "type": "integer",
          "minimum": 1,
          "default": 50
        }
      }
    },
    "agent": {
      "type": "object",
      "required": [
        "backend"
      ],
      "additionalProperties": false,
      "properties": {
        "backend": {
          "type": "string"
        },
        "image": {
          "type": "string",
          "minLength": 1,
          "description": "The image the run's pod uses instead of the runner image (ADR 0063): the reference the operator's `CHOREGOS_AGENT_IMAGES` maps the agent's image name to, built from the runner image."
        },
        "launch": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "command": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "env": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "files": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "model": {
      "type": "object",
      "required": [
        "litellm_model",
        "base_url",
        "api_format"
      ],
      "additionalProperties": false,
      "properties": {
        "litellm_model": {
          "type": "string"
        },
        "base_url": {
          "type": "string"
        },
        "api_format": {
          "type": "string",
          "enum": [
            "openai",
            "anthropic",
            "gemini"
          ]
        },
        "params": {
          "type": "object",
          "additionalProperties": true,
          "default": {}
        },
        "provider_model": {
          "type": [
            "string",
            "null"
          ],
          "description": "The real model behind the platform alias: what a constrained backend checks."
        }
      }
    },
    "gateway_key": {
      "type": "string",
      "description": "The run's virtual key (budget = the step's budget)."
    },
    "budget": {
      "type": "object",
      "required": [
        "usd",
        "max_turns",
        "max_minutes"
      ],
      "additionalProperties": false,
      "properties": {
        "usd": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "max_turns": {
          "type": "integer",
          "minimum": 1
        },
        "max_minutes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "allowed_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "context_pack_url": {
      "type": [
        "string",
        "null"
      ]
    },
    "playbook": {
      "type": "object",
      "required": [
        "ref"
      ],
      "additionalProperties": false,
      "properties": {
        "ref": {
          "type": "string"
        },
        "prompt_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "prompt": {
          "type": [
            "string",
            "null"
          ],
          "description": "The rendered prompt in plain text (dev and fakes)."
        }
      }
    },
    "tools": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mcp": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "url": {
                "type": "string"
              },
              "command": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "env": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "write_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "deny_commands": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "allow_domains": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dod_iterations": {
          "type": "integer",
          "minimum": 0,
          "default": 3
        },
        "unknown_requests": {
          "type": "string",
          "enum": [
            "allow",
            "reject"
          ],
          "default": "allow"
        },
        "max_findings": {
          "type": "integer",
          "minimum": 0,
          "default": 5
        }
      }
    },
    "context": {
      "type": "object",
      "description": "The context reduction the run starts with, resolved by the orchestrator (ADR 0055). Absent = everything off.",
      "additionalProperties": false,
      "properties": {
        "shell_filter": {
          "type": "string",
          "enum": [
            "none",
            "rtk"
          ],
          "default": "none"
        },
        "compression": {
          "type": "string",
          "enum": [
            "none",
            "headroom"
          ],
          "default": "none"
        },
        "headroom_profile": {
          "type": "string",
          "enum": [
            "coding",
            "balanced",
            "general"
          ],
          "default": "coding"
        },
        "on_unavailable": {
          "type": "string",
          "enum": [
            "bypass",
            "fail"
          ],
          "default": "bypass"
        },
        "rtk_exclude_commands": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "callbacks": {
      "type": "object",
      "required": [
        "api_url",
        "run_token"
      ],
      "additionalProperties": false,
      "properties": {
        "api_url": {
          "type": "string"
        },
        "run_token": {
          "type": "string"
        }
      }
    },
    "memory_scope": {
      "type": "string",
      "enum": [
        "none",
        "project",
        "agent"
      ],
      "default": "project",
      "description": "Whose memory the run reads and writes (S32-02): the project's shared memory, the agent's own within the project, or none."
    },
    "memories": {
      "type": "array",
      "default": [],
      "description": "The memories the run reads and writes, resolved by the platform and in precedence order (S40-11, ADR 0075). `memory_scope` stays, set to the legacy equivalent when there is one.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "scope", "slug", "namespace"],
        "properties": {
          "label": { "type": "string", "description": "`global:<slug>` or `project:<slug>`." },
          "scope": { "type": "string", "enum": ["global", "project"] },
          "slug": { "type": "string" },
          "mode": { "type": "string", "enum": ["read", "write"], "default": "read" },
          "namespace": { "type": "string", "description": "The string the memory adapters take to say where." }
        }
      }
    },
    "skills": {
      "type": "array",
      "description": "The registry agent's skills (ADR 0033): name, version, digest. The runner reads the files through the internal API and checks the digest before laying them down.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "slug",
          "version",
          "digest"
        ],
        "properties": {
          "slug": {
            "type": "string"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "digest": {
            "type": "string"
          }
        }
      }
    },
    "knowledge": {
      "type": "array",
      "description": "The registry agent's knowledge bases (ADR 0051). `files`: the runner fetches the pinned documents through the internal API, checks the digest and lays them read-only under `.choregos/knowledge/<slug>/`; `index`: the agent searches the base with `knowledge_search`.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "slug"
        ],
        "properties": {
          "slug": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "mode": {
            "type": "string",
            "enum": [
              "files",
              "index"
            ]
          },
          "documents": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "digest": {
            "type": "string"
          }
        }
      }
    },
    "job": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "command"
      ],
      "additionalProperties": false,
      "description": "Set for a job step (ADR 0056): the runner runs `command` and starts no agent; `agent`, `model` and `playbook` are placeholders.",
      "properties": {
        "command": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "image": {
          "type": [
            "string",
            "null"
          ]
        },
        "tools": {
          "type": "object",
          "description": "The connector operations the job may call through the internal API, by connector: the job's only access to the outside.",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "remote": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "endpoint",
        "card_url",
        "protocol_version",
        "card_digest",
        "timeout_s",
        "agent_slug"
      ],
      "additionalProperties": false,
      "description": "Set for a step a remote agent carries over A2A (ADR 0062): `agent.backend` is `a2a`, `model` a placeholder, no gateway key exists. The access token is NOT here: it travels in the run's Secret.",
      "properties": {
        "protocol": {
          "type": "string",
          "enum": [
            "a2a"
          ],
          "default": "a2a"
        },
        "endpoint": {
          "type": "string",
          "minLength": 1,
          "description": "the JSON-RPC endpoint messages are posted to (pinned at publication)"
        },
        "card_url": {
          "type": "string",
          "minLength": 1,
          "description": "where the card lives; the runner fetches it again and refuses on drift"
        },
        "protocol_version": {
          "type": "string",
          "minLength": 1
        },
        "skill": {
          "type": [
            "string",
            "null"
          ]
        },
        "card_digest": {
          "type": "string",
          "minLength": 1,
          "description": "sha256:<hex> of the card as it was when the version was published"
        },
        "timeout_s": {
          "type": "integer",
          "minimum": 1
        },
        "input": {
          "type": "string",
          "enum": [
            "text",
            "text+files"
          ],
          "default": "text"
        },
        "declared_cost": {
          "type": "object",
          "additionalProperties": false,
          "description": "what the registry entry declares: A2A reports no figure",
          "properties": {
            "per_task_usd": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "per_minute_usd": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            }
          }
        },
        "agent_slug": {
          "type": "string",
          "minLength": 1
        },
        "credential": {
          "type": [
            "string",
            "null"
          ],
          "description": "the name of the organisation credential the access token comes from (never the token)"
        }
      }
    }
  }
}
