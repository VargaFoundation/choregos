 "job-gate=False": {
  "apiVersion": "batch/v1",
  "kind": "Job",
  "metadata": {
   "labels": {
    "choregos/project": "demo",
    "choregos/run-id": "r-1",
    "choregos/work-item": "DEMO-1"
   },
   "name": "run-r-1",
   "namespace": "proj-demo-runners"
  },
  "spec": {
   "activeDeadlineSeconds": 7200,
   "backoffLimit": 0,
   "template": {
    "metadata": {
     "labels": {
      "app.kubernetes.io/component": "runner",
      "app.kubernetes.io/name": "choregos-runner",
      "choregos/run-id": "r-1"
     }
    },
    "spec": {
     "automountServiceAccountToken": false,
     "containers": [
      {
       "args": [
        "run"
       ],
       "env": [
        {
         "name": "TRANIBOR_RUN_ID",
         "value": "r-1"
        },
        {
         "name": "TRANIBOR_API_URL",
         "value": "http://choregos-api:8000"
        },
        {
         "name": "TRANIBOR_RUN_TOKEN",
         "valueFrom": {
          "secretKeyRef": {
           "key": "token",
           "name": "run-r-1"
          }
         }
        },
        {
         "name": "TRANIBOR_RUN_GATEWAY_KEY",
         "valueFrom": {
          "secretKeyRef": {
           "key": "gateway-key",
           "name": "run-r-1",
           "optional": true
          }
         }
        },
        {
         "name": "TRANIBOR_RUN_REMOTE_TOKEN",
         "valueFrom": {
          "secretKeyRef": {
           "key": "remote-token",
           "name": "run-r-1",
           "optional": true
          }
         }
        },
        {
         "name": "HTTP_PROXY",
         "value": "http://egress:3128"
        },
        {
         "name": "TRANIBOR_ENV",
         "value": "dev"
        }
       ],
       "envFrom": [
        {
         "secretRef": {
          "name": "git-credentials"
         }
        }
       ],
       "image": "registry.example/choregos-runner:1.0",
       "name": "runner",
       "resources": {
        "limits": {
         "cpu": "2",
         "memory": "6Gi"
        },
        "requests": {
         "cpu": "1",
         "memory": "2Gi"
        }
       },
       "securityContext": {
        "allowPrivilegeEscalation": false,
        "capabilities": {
         "drop": [
          "ALL"
         ]
        },
        "seccompProfile": {
         "type": "RuntimeDefault"
        }
       },
       "volumeMounts": [
        {
         "mountPath": "/workspace",
         "name": "workspace"
        }
       ]
      }
     ],
     "imagePullSecrets": [
      {
       "name": "pull"
      }
     ],
     "restartPolicy": "Never",
     "runtimeClassName": "gvisor",
     "securityContext": {
      "fsGroup": 1000,
      "runAsNonRoot": true,
      "runAsUser": 1000,
      "seccompProfile": {
       "type": "RuntimeDefault"
      }
     },
     "serviceAccountName": "choregos-runner",
     "volumes": [
      {
       "emptyDir": {
        "sizeLimit": "10Gi"
       },
       "name": "workspace"
      }
     ]
    }
   },
   "ttlSecondsAfterFinished": 3600
  }
 },
