{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://choregos.dev/schemas/conversation-evals.schema.json",
  "title": "ConversationEvals",
  "description": "A conversation suite an assistant ships (ADR 0140, ADR 0133): scenarios of user turns, the tool results a source's fake answers, and deterministic assertions on the conversation's journal (the ordered tool calls and the final texts). The assertions are exact and run first; `rubric` is scored by a judge model once the assertions pass; a case fails when any criterion is below its threshold. A tool is named `<need>__<operation>`, as the assistant's `tools` declare it.",
  "type": "object",
  "required": [
    "kind",
    "agent",
    "cases"
  ],
  "additionalProperties": false,
  "$defs": {
    "tool": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*__[a-z][a-z0-9_]*$",
      "description": "`<need>__<operation>`"
    },
    "text_match": {
      "description": "a word or phrase (case-insensitive, whole words) or an object with a regular expression",
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        {
          "type": "object",
          "required": [
            "regex"
          ],
          "additionalProperties": false,
          "properties": {
            "regex": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            }
          }
        }
      ]
    },
    "must_call": {
      "type": "object",
      "required": [
        "tool"
      ],
      "additionalProperties": false,
      "properties": {
        "tool": {
          "$ref": "#/$defs/tool"
        },
        "before": {
          "type": "string",
          "description": "`any`: this tool is the first call of the conversation (before any other read); a tool name: its first call comes before the first call of that tool, if that one is called at all"
        },
        "arguments_contain": {
          "type": "object",
          "description": "arguments the call must carry (each key equal to the given value)",
          "additionalProperties": true
        }
      }
    },
    "must_not_call": {
      "type": "object",
      "required": [
        "tool"
      ],
      "additionalProperties": false,
      "properties": {
        "tool": {
          "$ref": "#/$defs/tool"
        },
        "when": {
          "type": "object",
          "description": "the rule applies only when every given condition holds",
          "additionalProperties": false,
          "properties": {
            "context": {
              "type": "object",
              "description": "facts of the scenario (the case's `context`) that must all be equal",
              "additionalProperties": true
            },
            "called": {
              "$ref": "#/$defs/tool",
              "description": "this other tool was called in the conversation"
            }
          }
        }
      }
    },
    "must_cite": {
      "type": "object",
      "required": [
        "figure",
        "source"
      ],
      "additionalProperties": false,
      "properties": {
        "figure": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "description": "a regular expression matching each figure of a final text"
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "description": "a regular expression that must match right after each figure"
        },
        "within_chars": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000,
          "default": 120,
          "description": "how far after the figure the source may start to end"
        }
      }
    },
    "assertions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "must_call": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/tool"
              },
              {
                "$ref": "#/$defs/must_call"
              }
            ]
          }
        },
        "call_order": {
          "type": "array",
          "maxItems": 20,
          "description": "lists of tools: each list's tools are called in that order (not necessarily one after the other)",
          "items": {
            "type": "array",
            "minItems": 2,
            "items": {
              "$ref": "#/$defs/tool"
            }
          }
        },
        "must_not_call": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/tool"
              },
              {
                "$ref": "#/$defs/must_not_call"
              }
            ]
          }
        },
        "must_cite": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/must_cite"
          }
        },
        "must_not_contain": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "$ref": "#/$defs/text_match"
          }
        },
        "length": {
          "type": "object",
          "description": "the words of each final text",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "min_words": {
              "type": "integer",
              "minimum": 0
            },
            "max_words": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "case": {
      "type": "object",
      "required": [
        "name",
        "turns"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "maxLength": 500
        },
        "context": {
          "type": "object",
          "description": "facts of the scenario a `must_not_call.when.context` reads (for example `{relation: coachee}`)",
          "additionalProperties": true
        },
        "turns": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "description": "what the person says, one entry per turn",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        },
        "tool_results": {
          "type": "object",
          "description": "what the sources' fakes answer, by `<need>__<operation>`: a value is the answer of every call, an array is the answers of successive calls (the last one repeats)",
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]*__[a-z][a-z0-9_]*$"
          },
          "additionalProperties": true
        },
        "assert": {
          "$ref": "#/$defs/assertions"
        },
        "rubric": {
          "type": "array",
          "maxItems": 20,
          "description": "criteria scored by the judge model (0 to 1) after the assertions pass; each must reach its threshold",
          "items": {
            "type": "object",
            "required": [
              "criterion",
              "threshold"
            ],
            "additionalProperties": false,
            "properties": {
              "criterion": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "threshold": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        }
      }
    }
  },
  "properties": {
    "kind": {
      "const": "conversation"
    },
    "agent": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,62}$",
      "description": "the slug of the assistant's agent"
    },
    "description": {
      "type": "string",
      "maxLength": 500
    },
    "threshold": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "default": 1,
      "description": "the share of cases that must pass every deterministic assertion for the suite to pass; a version below it does not reach production"
    },
    "cases": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  }
}
