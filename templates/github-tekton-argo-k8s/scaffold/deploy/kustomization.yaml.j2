apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization
namespace: {{ project.slug }}-{{ env | default("dev") }}
commonLabels:
  app.kubernetes.io/name: {{ project.slug }}
  choregos/project: {{ project.slug }}
resources:
  - ../../base
images:
  - name: app
    newName: ghcr.io/{{ inputs.repo }}
    newTag: latest
