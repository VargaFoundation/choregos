{
  "title": "Choregos — Projects & Costs",
  "uid": "choregos-couts",
  "tags": [
    "choregos"
  ],
  "refresh": "5m",
  "panels": [
    {
      "type": "timeseries",
      "title": "Cost per day and per project (USD)",
      "targets": [
        {
          "expr": "sum(increase(choregos_cost_usd_total[1d])) by (project)"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "bargauge",
      "title": "Daily budget consumed",
      "targets": [
        {
          "expr": "choregos_project_daily_cost_usd / clamp_min(choregos_project_daily_budget_usd, 0.01)"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      }
    },
    {
      "type": "table",
      "title": "Cost per step and per model",
      "targets": [
        {
          "expr": "sum(increase(choregos_cost_usd_total[7d])) by (stage, model)"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      }
    },
    {
      "type": "stat",
      "title": "First-pass PR merge rate",
      "targets": [
        {
          "expr": "avg(choregos_first_pass_merge_rate)"
        }
      ],
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 0,
        "y": 16
      }
    }
  ]
}
