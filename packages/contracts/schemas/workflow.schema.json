{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://choregos.dev/schemas/workflow.schema.json",
  "title": "Workflow",
  "description": "DSL de workflow Choregos : machine à états déclarative par projet (docs/plan/01 §1.4).",
  "type": "object",
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "actors",
    "states",
    "transitions"
  ],
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "const": "choregos/v1"
    },
    "kind": {
      "const": "Workflow"
    },
    "metadata": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "#/$defs/slug"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "description": {
          "type": "string"
        },
        "extends": {
          "type": "string",
          "pattern": "^template:[a-z0-9-]+@[0-9]+$"
        },
        "inputs": {
          "type": "object",
          "description": "JSON Schema of the fields of a work item of this workflow (ADR 0031)."
        }
      }
    },
    "actors": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/identifier"
      },
      "additionalProperties": {
        "$ref": "#/$defs/actor"
      }
    },
    "states": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/identifier"
      },
      "additionalProperties": {
        "$ref": "#/$defs/state"
      }
    },
    "transitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/transition"
      }
    },
    "defaults": {
      "$ref": "#/$defs/defaults"
    },
    "initial": {
      "type": "string",
      "description": "Où commence le workflow. Facultatif : le parseur y écrit le premier état déclaré (§1.4). Le champ existe parce que l'ordre des clés d'un objet ne survit pas à un stockage jsonb, et qu'un workflow qui croit commencer par son état terminal clôt le ticket sans rien faire."
    }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$"
    },
    "actor": {
      "oneOf": [
        {
          "$ref": "#/$defs/agentActor"
        },
        {
          "$ref": "#/$defs/humanActor"
        },
        {
          "$ref": "#/$defs/systemActor"
        }
      ]
    },
    "agentActor": {
      "type": "object",
      "required": [
        "type",
        "role"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "agent"
        },
        "role": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{1,31}$",
          "description": "Rôle de l'agent. Les rôles du paquet — triage, refine, plan, implement, verify, review, fix_ci, address_review, release_notes, verify_prod, custom — gardent leur sens ; un métier nomme les siens (`sourcing`, `instruction_dossier`), et le playbook se résout par le nom du rôle."
        },
        "model": {
          "type": "string",
          "description": "profile:<name>, profile:by_size, ou un identifiant LiteLLM direct.",
          "default": "profile:by_size"
        },
        "backend": {
          "type": "string",
          "description": "Backend ACP imposé (sinon défaut du projet)."
        },
        "fresh_context": {
          "type": "boolean",
          "default": false
        },
        "max_turns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "max_minutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 480
        },
        "playbook": {
          "type": "string",
          "description": "Nom du playbook (défaut : le rôle)."
        },
        "agent": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,62}(@[1-9][0-9]*)?$",
          "description": "Un agent du registre (ADR 0033) : `slug`, ou `slug@version`. Sa version — l'épinglée du projet, sinon la dernière — fixe instructions, modèle, limites et budget ; ses instructions priment sur le playbook."
        }
      }
    },
    "humanActor": {
      "type": "object",
      "required": [
        "type",
        "group"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "human"
        },
        "group": {
          "type": "string"
        },
        "sla_hours": {
          "type": "integer",
          "minimum": 1
        },
        "escalate_to": {
          "type": "string"
        }
      }
    },
    "systemActor": {
      "type": "object",
      "required": [
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "system"
        }
      }
    },
    "state": {
      "type": "object",
      "required": [
        "display"
      ],
      "additionalProperties": false,
      "properties": {
        "display": {
          "type": "string",
          "minLength": 1
        },
        "tracker": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "type": "string"
            },
            "label": {
              "type": "string"
            }
          }
        },
        "terminal": {
          "type": "boolean",
          "default": false
        },
        "kind": {
          "type": "string",
          "enum": [
            "work",
            "wait",
            "terminal"
          ],
          "default": "work"
        }
      }
    },
    "transition": {
      "type": "object",
      "required": [
        "from",
        "to"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "from": {
          "type": "string",
          "description": "identifiant d'état, ou *agent (tout état piloté par un agent)"
        },
        "to": {
          "$ref": "#/$defs/identifier"
        },
        "by": {
          "$ref": "#/$defs/identifier"
        },
        "via": {
          "const": "release_train"
        },
        "train": {
          "type": "object",
          "required": [
            "env"
          ],
          "additionalProperties": false,
          "properties": {
            "env": {
              "type": "string"
            },
            "approval": {
              "$ref": "#/$defs/identifier"
            },
            "auto_sync": {
              "type": "boolean",
              "default": false
            }
          }
        },
        "gates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/gateRef"
          }
        },
        "outputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "on_fail": {
          "$ref": "#/$defs/retry"
        },
        "on_reject": {
          "$ref": "#/$defs/identifier"
        },
        "on_changes_requested": {
          "$ref": "#/$defs/retry"
        },
        "review": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "agents": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/identifier"
              }
            },
            "humans": {
              "type": "object",
              "required": [
                "group",
                "required"
              ],
              "additionalProperties": false,
              "properties": {
                "group": {
                  "type": "string"
                },
                "required": {
                  "type": "string",
                  "enum": [
                    "always",
                    "by_policy",
                    "never"
                  ]
                }
              }
            }
          }
        },
        "timeout_hours": {
          "type": "integer",
          "minimum": 1
        },
        "action": {
          "$ref": "#/$defs/transitionAction",
          "description": "une action gouvernée que la transition système propose (ADR 0035), à date"
        },
        "task": {
          "$ref": "#/$defs/task",
          "description": "une tâche qu'une personne fait : un formulaire dont les valeurs deviennent des champs, une attestation"
        }
      },
      "oneOf": [
        {
          "required": [
            "by"
          ],
          "not": {
            "required": [
              "via"
            ]
          }
        },
        {
          "required": [
            "via",
            "train"
          ],
          "not": {
            "required": [
              "by"
            ]
          }
        }
      ]
    },
    "retry": {
      "type": "object",
      "required": [
        "to",
        "max_attempts",
        "escalate_to"
      ],
      "additionalProperties": false,
      "properties": {
        "to": {
          "$ref": "#/$defs/identifier"
        },
        "max_attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "escalate_to": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "gateRef": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "required": [
            "name"
          ],
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string"
            },
            "params": {
              "type": "object",
              "additionalProperties": true
            }
          }
        }
      ]
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "from_any_agent_state": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "on_question": {
              "$ref": "#/$defs/identifier"
            },
            "on_budget_exceeded": {
              "$ref": "#/$defs/identifier"
            },
            "on_timeout": {
              "$ref": "#/$defs/identifier"
            }
          }
        },
        "needs_human": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "on_answer": {
              "type": "string",
              "enum": [
                "resume"
              ]
            },
            "on_abandon": {
              "$ref": "#/$defs/identifier"
            }
          }
        }
      }
    },
    "actionEffect": {
      "type": "object",
      "required": [
        "effect"
      ],
      "additionalProperties": false,
      "properties": {
        "effect": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "with": {
          "type": "object"
        },
        "compensate": {
          "type": "object"
        }
      }
    },
    "actionApproval": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "approvers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "role": {
                "type": "string",
                "enum": [
                  "developer",
                  "release_captain",
                  "project_owner",
                  "org_admin"
                ]
              },
              "min": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              }
            }
          }
        },
        "step_up_minutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120
        },
        "separation_of_duties": {
          "type": "boolean"
        }
      }
    },
    "transitionAction": {
      "type": "object",
      "required": [
        "kind",
        "title",
        "effects"
      ],
      "additionalProperties": false,
      "description": "titre, justification et paramètres rendus avec les champs du ticket ; une validation humaine quand une opération l'exige ou quand `approval` est déclaré",
      "properties": {
        "kind": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "justification": {
          "type": "string",
          "maxLength": 4000
        },
        "params": {
          "type": "object"
        },
        "effects": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/actionEffect"
          }
        },
        "approval": {
          "$ref": "#/$defs/actionApproval"
        },
        "not_before": {
          "type": "string",
          "pattern": "^fields\\.[a-z_][a-z0-9_]{0,62}(\\s*[+-]\\s*[0-9]{1,4}\\s*[dhm])?$",
          "description": "pas avant cette date, tirée d'un champ du ticket : `fields.date_arrivee - 10d`"
        }
      }
    },
    "task": {
      "type": "object",
      "required": [
        "form"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 200
        },
        "instructions": {
          "type": "string",
          "maxLength": 4000
        },
        "form": {
          "type": "object",
          "description": "un JSON Schema d'objet ; chaque propriété est un champ du ticket"
        },
        "attest": {
          "type": "string",
          "maxLength": 500,
          "description": "ce que la personne atteste, mot pour mot"
        }
      }
    }
  }
}
