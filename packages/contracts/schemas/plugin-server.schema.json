{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://choregos.dev/schemas/plugin-server.schema.json",
  "title": "PluginServer",
  "description": "An MCP server a plugin brings, run and governed by the platform (ADR 0093, plan S43 Decision 2).",
  "type": "object",
  "required": [
    "name",
    "image",
    "port",
    "protocol",
    "operations"
  ],
  "additionalProperties": false,
  "$defs": {
    "operation": {
      "type": "object",
      "description": "a tool the server may serve; a tool not listed is refused",
      "required": [
        "name",
        "access"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "access": {
          "enum": [
            "read",
            "write"
          ],
          "description": "required: nothing is assumed read"
        },
        "description": {
          "type": "string",
          "maxLength": 500
        },
        "human_approval": {
          "type": "boolean",
          "default": false,
          "description": "a floor: an organisation may raise it, never lower it"
        },
        "compensation": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "description": "the operation that undoes this one; a write only"
        },
        "input_schema": {
          "type": "object",
          "description": "a JSON Schema of the tool's arguments"
        }
      },
      "if": {
        "properties": {
          "access": {
            "const": "read"
          }
        },
        "required": [
          "access"
        ]
      },
      "then": {
        "not": {
          "required": [
            "compensation"
          ]
        }
      }
    }
  },
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
    },
    "image": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._/:-]{0,254}@sha256:[0-9a-f]{64}$",
      "description": "pinned by digest; a tag alone is refused"
    },
    "port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "protocol": {
      "enum": [
        "mcp-http"
      ]
    },
    "config_schema": {
      "type": "object",
      "description": "a JSON Schema of what an administrator types"
    },
    "secret_fields": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{0,63}$"
      },
      "description": "sealed (ADR 0058), passed by the broker's call, never to a run"
    },
    "egress": {
      "type": "object",
      "description": "where the server may connect: hosts read from configuration fields, or fixed hosts",
      "additionalProperties": false,
      "minProperties": 1,
      "maxProperties": 1,
      "properties": {
        "from_fields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          }
        },
        "hosts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9*][A-Za-z0-9.*-]{0,252}$"
          }
        }
      }
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/operation"
      }
    },
    "implements": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "tracker"
        ]
      }
    },
    "webhook": {
      "type": "object",
      "required": [
        "path"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^/[A-Za-z0-9/_-]{0,127}$"
        }
      }
    }
  }
}
