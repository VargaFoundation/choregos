{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://choregos.dev/schemas/workflow.schema.json",
  "title": "Workflow",
  "description": "DSL de workflow Choregos : machine à états déclarative par projet (docs/plan/01 §1.4).",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "actors", "states", "transitions"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": { "const": "choregos/v1" },
    "kind": { "const": "Workflow" },
    "metadata": {
      "type": "object",
      "required": ["name", "version"],
      "additionalProperties": false,
      "properties": {
        "name": { "$ref": "#/$defs/slug" },
        "version": { "type": "integer", "minimum": 1 },
        "description": { "type": "string" },
        "extends": { "type": "string", "pattern": "^template:[a-z0-9-]+@[0-9]+$" }
      }
    },
    "actors": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/identifier" },
      "additionalProperties": { "$ref": "#/$defs/actor" }
    },
    "states": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/identifier" },
      "additionalProperties": { "$ref": "#/$defs/state" }
    },
    "transitions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/transition" }
    },
    "defaults": { "$ref": "#/$defs/defaults" }
  },
  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$" },
    "identifier": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$" },
    "actor": {
      "oneOf": [
        { "$ref": "#/$defs/agentActor" },
        { "$ref": "#/$defs/humanActor" },
        { "$ref": "#/$defs/systemActor" }
      ]
    },
    "agentActor": {
      "type": "object",
      "required": ["type", "role"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "agent" },
        "role": {
          "type": "string",
          "enum": ["triage", "refine", "plan", "implement", "verify", "review", "fix_ci",
                   "address_review", "release_notes", "verify_prod", "custom"]
        },
        "model": {
          "type": "string",
          "description": "profile:<name>, profile:by_size, ou un identifiant LiteLLM direct.",
          "default": "profile:by_size"
        },
        "backend": { "type": "string", "description": "Backend ACP imposé (sinon défaut du projet)." },
        "fresh_context": { "type": "boolean", "default": false },
        "max_turns": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "max_minutes": { "type": "integer", "minimum": 1, "maximum": 480 },
        "playbook": { "type": "string", "description": "Nom du playbook (défaut : le rôle)." }
      }
    },
    "humanActor": {
      "type": "object",
      "required": ["type", "group"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "human" },
        "group": { "type": "string" },
        "sla_hours": { "type": "integer", "minimum": 1 },
        "escalate_to": { "type": "string" }
      }
    },
    "systemActor": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": { "type": { "const": "system" } }
    },
    "state": {
      "type": "object",
      "required": ["display"],
      "additionalProperties": false,
      "properties": {
        "display": { "type": "string", "minLength": 1 },
        "tracker": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "status": { "type": "string" }, "label": { "type": "string" } }
        },
        "terminal": { "type": "boolean", "default": false },
        "kind": { "type": "string", "enum": ["work", "wait", "terminal"], "default": "work" }
      }
    },
    "transition": {
      "type": "object",
      "required": ["from", "to"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "from": { "type": "string", "description": "identifiant d'état, ou *agent (tout état piloté par un agent)" },
        "to": { "$ref": "#/$defs/identifier" },
        "by": { "$ref": "#/$defs/identifier" },
        "via": { "const": "release_train" },
        "train": {
          "type": "object",
          "required": ["env"],
          "additionalProperties": false,
          "properties": {
            "env": { "type": "string" },
            "approval": { "$ref": "#/$defs/identifier" },
            "auto_sync": { "type": "boolean", "default": false }
          }
        },
        "gates": { "type": "array", "items": { "$ref": "#/$defs/gateRef" } },
        "outputs": { "type": "array", "items": { "type": "string" } },
        "inputs": { "type": "array", "items": { "type": "string" } },
        "on_fail": { "$ref": "#/$defs/retry" },
        "on_reject": { "$ref": "#/$defs/identifier" },
        "on_changes_requested": { "$ref": "#/$defs/retry" },
        "review": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "agents": { "type": "array", "items": { "$ref": "#/$defs/identifier" } },
            "humans": {
              "type": "object",
              "required": ["group", "required"],
              "additionalProperties": false,
              "properties": {
                "group": { "type": "string" },
                "required": { "type": "string", "enum": ["always", "by_policy", "never"] }
              }
            }
          }
        },
        "timeout_hours": { "type": "integer", "minimum": 1 }
      },
      "oneOf": [
        { "required": ["by"], "not": { "required": ["via"] } },
        { "required": ["via", "train"], "not": { "required": ["by"] } }
      ]
    },
    "retry": {
      "type": "object",
      "required": ["to", "max_attempts", "escalate_to"],
      "additionalProperties": false,
      "properties": {
        "to": { "$ref": "#/$defs/identifier" },
        "max_attempts": { "type": "integer", "minimum": 1, "maximum": 10 },
        "escalate_to": { "$ref": "#/$defs/identifier" }
      }
    },
    "gateRef": {
      "oneOf": [
        { "type": "string" },
        {
          "type": "object",
          "required": ["name"],
          "additionalProperties": false,
          "properties": {
            "name": { "type": "string" },
            "params": { "type": "object", "additionalProperties": true }
          }
        }
      ]
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "from_any_agent_state": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "on_question": { "$ref": "#/$defs/identifier" },
            "on_budget_exceeded": { "$ref": "#/$defs/identifier" },
            "on_timeout": { "$ref": "#/$defs/identifier" }
          }
        },
        "needs_human": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "on_answer": { "type": "string", "enum": ["resume"] },
            "on_abandon": { "$ref": "#/$defs/identifier" }
          }
        }
      }
    }
  }
}
