{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://choregos.dev/schemas/artifact.schema.json",
  "title": "Artifact",
  "description": "One revision of a named output of a work item: typed, stored and traced (ADR 0049).",
  "type": "object",
  "required": ["name", "type", "kind", "media_type", "version", "digest", "size", "produced_by"],
  "additionalProperties": false,
  "properties": {
    "name": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$", "description": "The output's name, as the transition declares it." },
    "type": {
      "type": "string",
      "enum": ["markdown", "json", "mermaid", "sarif", "text", "csv", "html", "pdf", "docx", "xlsx", "pptx", "png", "jpeg", "gif", "webp", "svg", "mp4", "webm", "file", "diff", "level", "metric", "keyvalue"],
      "description": "The declared type, or the type of the value or file."
    },
    "kind": { "type": "string", "enum": ["markdown", "json", "diagram", "report", "file", "diff", "value"], "description": "How the platform handles it." },
    "media_type": { "type": "string", "description": "The IANA media type the content is served with." },
    "version": { "type": "integer", "minimum": 1, "description": "1 for the first revision; a new content makes the next one." },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$", "description": "sha256 of the bytes served on download, checked again on every read." },
    "size": { "type": "integer", "minimum": 0, "description": "Size of the content in bytes." },
    "produced_by": {
      "type": "object",
      "description": "The run that produced this revision, and the agent behind it.",
      "required": ["run_id"],
      "additionalProperties": false,
      "properties": {
        "run_id": { "type": "string" },
        "stage": { "type": ["string", "null"] },
        "attempt": { "type": ["integer", "null"], "minimum": 1 },
        "agent": { "type": ["string", "null"], "description": "The registry agent (ADR 0033); null for a playbook." },
        "agent_version": { "type": ["integer", "null"], "minimum": 1 }
      }
    },
    "storage_url": { "type": ["string", "null"], "description": "Where the bytes are in the object store; null for an inline artifact." },
    "created_at": { "type": ["string", "null"], "format": "date-time" },
    "display": {
      "description": "How the console shows this revision (ADR 0129); null when nothing is said beyond its type. Outside the digest.",
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/display" }]
    },
    "value": {
      "type": ["string", "number", "null"],
      "description": "A `level` or a `metric`, once its digest checked (ADR 0129); anything else is read from its content."
    }
  },
  "$defs": {
    "display": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "type": ["string", "null"], "description": "The type it is drawn as; null only in a stage's input, when its value will settle it." },
        "show": { "type": "string", "enum": ["facts", "tab", "hidden"], "default": "tab", "description": "Where it is seen: the ticket's facts card, its tab, or nowhere." },
        "title": { "type": ["string", "null"] },
        "diff": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/diffStat" }] },
        "levels": {
          "type": ["array", "null"],
          "description": "A `level`'s scale, lowest first.",
          "items": {
            "type": "object",
            "required": ["value"],
            "additionalProperties": false,
            "properties": {
              "value": { "type": "string" },
              "tone": { "type": "string", "enum": ["neutral", "info", "ok", "warn", "danger"], "default": "neutral" },
              "title": { "type": ["string", "null"] }
            }
          }
        },
        "unit": { "type": ["string", "null"] },
        "min": { "type": ["number", "null"] },
        "max": { "type": ["number", "null"] },
        "better": { "type": ["string", "null"], "enum": ["higher", "lower", null] }
      }
    },
    "diffStat": {
      "type": "object",
      "required": ["files", "additions", "deletions"],
      "additionalProperties": false,
      "properties": {
        "files": { "type": "integer", "minimum": 0 },
        "additions": { "type": "integer", "minimum": 0 },
        "deletions": { "type": "integer", "minimum": 0 },
        "truncated": { "type": "boolean", "default": false, "description": "The diff was too large and was cut, file by file." },
        "withheld": { "type": "array", "items": { "type": "string" }, "description": "The shapes of secret found: the patch was withheld. Never a value." }
      }
    }
  }
}
