{
  "title": "Choregos — Trains",
  "uid": "choregos-trains",
  "tags": [
    "choregos"
  ],
  "panels": [
    {
      "type": "table",
      "title": "Train status",
      "targets": [
        {
          "expr": "choregos_train_status"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "stat",
      "title": "Frozen trains",
      "targets": [
        {
          "expr": "sum(choregos_train_frozen)"
        }
      ],
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      }
    },
    {
      "type": "timeseries",
      "title": "Deployments and rollbacks",
      "targets": [
        {
          "expr": "sum(increase(choregos_releases_total[1d])) by (status)"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      }
    },
    {
      "type": "stat",
      "title": "DORA — lead time to production (median)",
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum(rate(choregos_lead_time_seconds_bucket[7d])) by (le))"
        }
      ],
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 8
      }
    }
  ]
}
