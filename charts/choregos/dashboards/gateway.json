{
  "title": "Choregos — Gateway",
  "uid": "choregos-gateway",
  "tags": ["choregos"],
  "panels": [
    {
      "type": "timeseries",
      "title": "Tokens par minute et par modèle",
      "targets": [{ "expr": "sum(rate(litellm_total_tokens[5m])) by (model)" }],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 }
    },
    {
      "type": "timeseries",
      "title": "Clés coupées au plafond",
      "targets": [{ "expr": "sum(increase(litellm_budget_exceeded_total[1h]))" }],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 }
    },
    {
      "type": "timeseries",
      "title": "Latence des appels modèles (p95)",
      "targets": [{ "expr": "histogram_quantile(0.95, sum(rate(litellm_request_duration_seconds_bucket[5m])) by (le, model))" }],
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 }
    }
  ]
}
