# Local install (`docker compose up`): copy to `.env`, then change what you need.
# Every line is optional. With nothing set, Choregos runs in fakes mode: agents are simulated,
# no model is called, nothing leaves the machine.

# The e-mail you sign in with (development sign-in, no password). It is the demo organisation's admin.
CHOREGOS_ADMIN_EMAIL=admin@choregos.local

# Host ports, if the defaults are taken on your machine.
CHOREGOS_PORT_WEB=3000
CHOREGOS_PORT_API=8000
CHOREGOS_PORT_TEMPORAL_UI=8233
