{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://choregos.dev/schemas/finding.schema.json",
  "title": "Finding",
  "description": "A problem an agent found outside its scope.",
  "type": "object",
  "required": ["title", "type", "severity", "evidence"],
  "additionalProperties": false,
  "properties": {
    "title": { "type": "string", "minLength": 3, "maxLength": 200 },
    "type": { "type": "string", "enum": ["perf", "bug", "security", "tech-debt", "docs", "flaky-test", "ux"] },
    "severity": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
    "evidence": { "type": "string", "minLength": 1, "description": "path:line, test output, query…" },
    "suggested_fix": { "type": "string" },
    "estimate": { "type": "string", "enum": ["S", "M", "L"] },
    "out_of_scope_reason": { "type": "string" }
  }
}
