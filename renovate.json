{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":dependencyDashboard"
  ],
  "timezone": "Europe/Paris",
  "schedule": [
    "before 6am on monday"
  ],
  "labels": [
    "dependencies"
  ],
  "prConcurrentLimit": 5,
  "commitMessagePrefix": "chore(deps):",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 6am on monday"
    ]
  },
  "vulnerabilityAlerts": {
    "labels": [
      "securite"
    ],
    "schedule": [
      "at any time"
    ]
  },
  "pip-compile": {
    "managerFilePatterns": [
      "/^docker/headroom/requirements\\.txt$/"
    ]
  },
  "packageRules": [
    {
      "description": "Safe patch bumps are grouped and merged on their own if CI passes.",
      "matchUpdateTypes": [
        "patch",
        "pin",
        "digest"
      ],
      "groupName": "correctifs",
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Temporal, SQLAlchemy and Pydantic carry contracts: never automerge.",
      "matchPackageNames": [
        "temporalio",
        "sqlalchemy",
        "alembic",
        "pydantic",
        "pydantic-settings",
        "fastapi"
      ],
      "automerge": false,
      "labels": [
        "dependencies",
        "revue-requise"
      ]
    },
    {
      "description": "The front end moves together (Next, React, TanStack).",
      "matchFileNames": [
        "apps/web/**"
      ],
      "groupName": "front"
    },
    {
      "description": "Images and charts: by digest, the signature is checked again at deployment.",
      "matchManagers": [
        "helmv3",
        "dockerfile",
        "kubernetes",
        "argocd"
      ],
      "groupName": "images et charts",
      "automerge": false
    },
    {
      "description": "Agent backends: every bump must pass the conformance suite (S2-11).",
      "matchManagers": [
        "custom.regex"
      ],
      "matchFileNames": [
        "packages/runner/src/choregos_runner/backends/versions.lock"
      ],
      "groupName": "backends ACP",
      "automerge": false,
      "labels": [
        "dependencies",
        "conformance"
      ],
      "prBodyNotes": [
        "⚠️ Le job `conformance-backends` de la CI doit être vert : un backend qui ne passe pas les 7 vérifications ACP ne part pas en production."
      ]
    },
    {
      "description": "headroom (ADR 0055): recompiled with its hashes by `uv pip compile` (the command in the file's header), never edited line by line, and never automerged: a bump changes what an agent reads.",
      "matchFileNames": [
        "docker/headroom/**"
      ],
      "matchManagers": [
        "pip-compile"
      ],
      "groupName": "headroom",
      "minimumReleaseAge": "14 days",
      "automerge": false
    },
    {
      "description": "The hashed headroom lock belongs to `pip-compile`, not to `pip_requirements`.",
      "matchFileNames": [
        "docker/headroom/**"
      ],
      "matchManagers": [
        "pip_requirements"
      ],
      "enabled": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "ACP agent versions pinned in the runner image (annotated lines).",
      "managerFilePatterns": [
        "/^packages/runner/src/choregos_runner/backends/versions\\.lock$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+\\S+=(?<currentValue>\\S+)"
      ],
      "versioningTemplate": "semver-coerced"
    }
  ]
}
