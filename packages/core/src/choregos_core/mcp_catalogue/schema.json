{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://choregos.dev/schemas/mcp-catalogue.schema.json",
  "title": "MCP server catalogue (ADR 0065)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "catalogue_version", "generated_at", "sources", "entries"],
  "properties": {
    "schema_version": { "const": 1 },
    "catalogue_version": { "type": "string" },
    "generated_at": { "type": "string" },
    "sources": { "type": "object", "additionalProperties": { "type": "string" } },
    "entries": { "type": "array", "items": { "$ref": "#/$defs/entry" } }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "title", "description", "publisher", "official", "reference", "transport", "auth",
        "categories"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 80 },
        "description": { "type": "string", "minLength": 1, "maxLength": 300 },
        "publisher": { "type": "string", "minLength": 1 },
        "official": { "type": "boolean" },
        "reference": { "type": "boolean" },
        "registry_name": { "type": ["string", "null"] },
        "registry_version": { "type": ["string", "null"] },
        "repo": { "type": ["string", "null"], "pattern": "^https://github\\.com/[^/]+/[^/]+$" },
        "licence": { "type": ["string", "null"] },
        "terms_url": { "type": ["string", "null"], "pattern": "^https://" },
        "transport": { "enum": ["remote", "stdio"] },
        "remote": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["url", "protocol"],
              "properties": {
                "url": { "type": "string", "pattern": "^https://[^{}\\s]+$" },
                "protocol": { "enum": ["streamable-http", "sse"] }
              }
            },
            { "type": "null" }
          ]
        },
        "auth": { "type": "string", "pattern": "^(none|bearer|oauth|header:[A-Za-z0-9-]+)$" },
        "egress_hosts": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "categories": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "developer-tools", "source-control", "project-management", "documentation", "knowledge",
              "data", "databases", "observability", "security", "cloud", "browser", "search",
              "communication", "crm", "finance", "commerce", "design", "productivity", "ai-ml"
            ]
          }
        },
        "stars": { "type": ["integer", "null"], "minimum": 0 },
        "stars_as_of": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "hosting": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["package"],
              "properties": {
                "package": { "type": "string" },
                "version": { "type": ["string", "null"] }
              }
            },
            { "type": "null" }
          ]
        }
      }
    }
  }
}
