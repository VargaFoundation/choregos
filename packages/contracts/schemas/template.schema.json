{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://choregos.dev/schemas/template.schema.json",
  "title": "Template",
  "description": "Manifeste d'un template de stack (docs/plan/03 §3.2).",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "requires", "defaults", "inputs", "steps"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": { "const": "choregos/v1" },
    "kind": { "const": "Template" },
    "metadata": {
      "type": "object",
      "required": ["name", "version", "display"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "display": { "type": "string" },
        "description": { "type": "string" }
      }
    },
    "requires": {
      "type": "object",
      "required": ["connectors"],
      "additionalProperties": false,
      "properties": {
        "connectors": {
          "type": "object",
          "additionalProperties": { "type": "string" },
          "description": "kind → type attendu, ex. tracker: github-issues"
        },
        "cluster_capabilities": { "type": "array", "items": { "type": "string" } },
        "azure_capabilities": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Azure resource providers to register, e.g. Microsoft.App/managedEnvironments"
        },
        "org_connectors": {
          "type": "object",
          "additionalProperties": { "type": "string" },
          "description": "the ORGANISATION's connectors that the workflows call, by name → capability (S20-07), e.g. annuaire: identity"
        }
      }
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "workflow": { "type": "string", "description": "un seul workflow : la forme d'avant `workflows`" },
        "workflows": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" },
          "description": "the workflows shipped (ADR 0031): `template:<name>@<v>`, a core template, or a path relative to the template's folder (`workflows/arrivee.yaml`)"
        },
        "default_workflow": { "type": "string", "description": "the default workflow's name; otherwise the first one shipped" },
        "routing": {
          "type": "array",
          "description": "the project's routing rules, as PUT /projects/{id}/workflow-routing",
          "items": {
            "type": "object",
            "required": ["when", "workflow"],
            "additionalProperties": false,
            "properties": {
              "when": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "labels_any": { "type": "array", "items": { "type": "string" } },
                  "labels_all": { "type": "array", "items": { "type": "string" } },
                  "item_type": { "type": "string" }
                }
              },
              "workflow": { "type": "string" }
            }
          }
        },
        "policy": { "type": "string" },
        "models": { "type": "string" },
        "agent": { "type": "string" },
        "agents": {
          "type": "array",
          "items": { "type": "string" },
          "description": "the agents installed in the organisation when a project is born, if they are not there: files of the template in the `POST /orgs/{org}/agents` format, or `catalogue:<slug>` (S20-07, ADR 0040)"
        },
        "skills": {
          "type": "array",
          "items": { "type": "string" },
          "description": "the skills installed the same way: folders of the template, each with its SKILL.md, or `catalogue:<slug>` (S20-07)"
        },
        "extensions": {
          "type": "object",
          "propertyNames": { "pattern": "^[a-z][a-z0-9-]{0,62}$" },
          "additionalProperties": { "type": "string" },
          "description": "what a PLUGIN installs in the project when it is born: an installer name → a folder of the template (`ontology: ./ontology`). Without a plugin to install it, the project is born without it, and the audit log says so (S20-09)"
        }
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "type"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "type": { "type": "string",
            "enum": ["string", "enum", "list", "bool", "int", "github-repo", "cluster-ref", "secret-ref"] },
          "required": { "type": "boolean", "default": false },
          "default": {},
          "values": { "type": "array", "items": { "type": "string" } },
          "description": { "type": "string" }
        }
      }
    },
    "steps": {
      "type": "array",
      "description": "the provisioning steps; none for a project without a repository (S20-07)",
      "items": {
        "oneOf": [
          { "type": "string" },
          {
            "type": "object",
            "minProperties": 1,
            "maxProperties": 1,
            "additionalProperties": { "type": "object", "additionalProperties": true }
          }
        ]
      }
    },
    "scaffold": { "type": "string", "default": "./scaffold" }
  }
}
