           "optional": true
          }
         }
        },
        {
         "name": "TRANIBOR_RUN_REMOTE_TOKEN",
         "valueFrom": {
          "secretKeyRef": {
           "key": "remote-token",
           "name": "run-r-1",
           "optional": true
          }
         }
        },
        {
         "name": "HTTP_PROXY",
         "value": "http://egress:3128"
        },
