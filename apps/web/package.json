{
  "name": "@choregos/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "bundle:check": "node scripts/bundle-budget.mjs",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "theme:defaults": "node scripts/export-theme-defaults.mts",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:live": "playwright test -c playwright.live.config.ts",
    "e2e:embed": "playwright test -c playwright.embed.config.ts",
    "e2e:assistants": "playwright test -c playwright.assistants.config.ts",
    "mock:api": "prism mock ../../packages/contracts/openapi.yaml -p 4010"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "6.13.1",
    "@codemirror/lint": "6.9.7",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/highlight": "1.2.5",
    "@lezer/yaml": "1.0.4",
    "@tanstack/react-query": "^5.107.1",
    "clsx": "^2.1.1",
    "geist": "^1.9.2",
    "lucide-react": "^1.70.0",
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/eslintrc": "^3.2.0",
    "@playwright/test": "^1.65.0",
    "@radix-ui/colors": "^3.0.0",
    "@tailwindcss/postcss": "4.3.5",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "^9.17.0",
    "eslint-config-next": "^16.4.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "jsdom": "^31.0.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@12.4.2"
}
